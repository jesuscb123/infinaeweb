# Configuración SMTP del formulario de contacto (api/contacto.php).
# Copia este archivo a ".env" (en la raíz del proyecto) y rellena tus datos reales.
# ".env" no se sube al repositorio (ver .gitignore): cada entorno tiene el suyo.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
# tls (STARTTLS, puerto habitual 587) o ssl (SMTPS, puerto habitual 465)
SMTP_SECURE=tls
SMTP_USER=usuario@example.com
SMTP_PASS=contraseña-o-token-de-aplicacion

# Remitente que verán los destinatarios del correo
SMTP_FROM_EMAIL=web@infinaeconsulting.com
SMTP_FROM_NAME=Infinae Web

# Dirección que recibe los mensajes enviados desde el formulario
CONTACT_TO_EMAIL=info@infinaeconsulting.com
CONTACT_TO_NAME=Infinae
